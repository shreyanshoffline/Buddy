# Copy this file to .env and add your own values.
# Never commit .env, OAuth tokens, credential JSON, or private keys.

API_KEY=
HACK_CLUB_SEARCH_API_KEY=

# Optional local account/billing backend.
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
HACKCLUB_REDIRECT_URI=http://127.0.0.1:5000/auth/hackclub/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_ID_PRO_MONTHLY=
PRICE_ID_PRO_YEARLY=
PRICE_ID_MAX_MONTHLY=
PRICE_ID_MAX_YEARLY=

# Optional backend/runtime overrides.
BUDDY_START_BACKEND=1
BUDDY_BACKEND_HOST=127.0.0.1
BUDDY_BACKEND_PORT=5000
BUDDY_BILLING_URL=
SLACK_API_BASE=

# AI provider. Keep "openrouter" for the current hosted-model architecture.
# Switch to "self_hosted" for a remote OpenAI-compatible server such as
# llama.cpp/llama-server, vLLM, or Ollama. The desktop app and agent tools do
# not change when this switch is made.
BUDDY_AI_PROVIDER=openrouter
BUDDY_SELF_HOSTED_URL=http://127.0.0.1:8000/v1
BUDDY_SELF_HOSTED_MODEL=
BUDDY_SELF_HOSTED_API_KEY=
# Optional. Leave empty to use keyword-based local memory retrieval.
BUDDY_SELF_HOSTED_EMBEDDING_MODEL=
# Image generation remains on the hosted provider by default. Set this to
# self_hosted only when that server supports compatible image generation.
BUDDY_IMAGE_PROVIDER=openrouter
